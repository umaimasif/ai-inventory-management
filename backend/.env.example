# Copy to .env and adjust.

# Database
# Local dev default (SQLite, no install needed):
DATABASE_URL=sqlite:///./inventory.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/inventory

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (frontend origin)
FRONTEND_ORIGIN=http://localhost:3000

# LLM (optional). Leave GROQ_API_KEY blank to run agents with template phrasing
# (fully functional, no external calls). Set it to enable natural-language
# phrasing of the already-computed facts.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
